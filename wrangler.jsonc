{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "toyventor",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-26",
	"routes": [
		{ "pattern": "toyventor.com", "custom_domain": true },
		{ "pattern": "www.toyventor.com", "custom_domain": true }
	],
	"workers_dev": true,
	"assets": {
		// Client routes (tabs, pushed screens) fall back to the SPA shell
		// instead of 404ing or reaching the Worker; API and legacy World
		// share-link redirects run in the Worker first.
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/world/ToyVentor-World.html"]
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	// Ownership store. Local dev uses its own SQLite file; this id targets
	// the remote D1 database for deploys and --remote commands.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "toyventor",
			"database_id": "98804f95-0577-4f18-997d-4b26a0d484f7",
			"migrations_dir": "migrations"
		}
	],
	// Workers AI binding: /api/voice speaks "green tree" with google/gemini-3.8-flash-lite-tts (worker/voice.ts). Third-party
	// models bill through AI Gateway Unified Billing, so there is no provider key to store. The binding is remote-only: it
	// reaches Cloudflare (and bills) even under `wrangler dev`.
	"ai": { "binding": "AI" },
	// The Make-from-words maker: a Container behind its own Worker with no public address (containers/forge-maker). It must be deployed FIRST,
	// because a deploy of this Worker fails while the named service does not exist. With FORGE_OPTIMIZER_URL unset, worker/forgeOptimizer.ts uses it.
	// Local dev (vite or wrangler dev) prints a warning that this service cannot be resolved; set FORGE_OPTIMIZER_URL in .dev.vars to use the Mac daemon.
	"services": [{ "binding": "FORGE_MAKER", "service": "toyventor-forge-maker" }]
}