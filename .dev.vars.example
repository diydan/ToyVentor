# Copy to .dev.vars for local dev. Never put real values in THIS file:
# it is committed. The Worker reads these, the browser never does.
MODEL_API_KEY=
META_MODEL_API_URL=https://api.meta.ai/v1
MUREKA_API_KEY=
# Optional: model id for Create mode (/api/muse/spark). Empty means the
# default in worker/muse.ts.
MUSE_SPARK_MODEL=
