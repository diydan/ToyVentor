{
  "name": "toyventor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "e2e": "node scripts/e2e-chrome.mjs",
    "e2e:trail": "node scripts/e2e-trail.mjs",
    "e2e:kip-menu": "node scripts/e2e-kip-menu.mjs",
    "e2e:kip-print": "node scripts/e2e-kip-print.mjs",
    "e2e:kip-selfie": "node scripts/e2e-kip-selfie.mjs",
    "e2e:kip-photo-print": "tsx scripts/e2e-kip-photo-print.mjs",
    "e2e:kip-household": "tsx scripts/e2e-kip-household.mjs",
    "e2e:workshop": "node scripts/e2e-workshop.mjs",
    "e2e:bench-lifecycle": "node scripts/e2e-bench-lifecycle.mjs",
    "e2e:bench-stage": "node scripts/e2e-bench-stage.mjs",
    "e2e:truck-drive": "node scripts/e2e-truck-drive.mjs",
    "e2e:truck-band": "node scripts/e2e-truck-band.mjs",
    "e2e:truck-print": "node scripts/e2e-truck-print.mjs",
    "build": "tsc --noEmit && vite build && rm -f dist/toyventor/.dev.vars",
    "build:kip": "tsx scripts/build-kip.ts",
    "kip:validate-part": "tsx scripts/validate-llm-part.ts",
    "forge:optimizer": "tsx scripts/forge-optimizer.ts",
    "kip:plate-check": "node scripts/kip-plate-check.mjs",
    "kip:serve": "node scripts/kip-serve.mjs",
    "kip:validation-index": "node scripts/kip-validation-index.mjs",
    "partspec:quiet": "node scripts/partspec-quiet.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate-sets.ts",
    "parts": "bash scripts/build-parts.sh",
    "parts:tune-llm": "tsx scripts/llm-lod-advisor.ts",
    "parts:optimize": "tsx scripts/bridge-partspec.ts --verify-preprint",
    "bridge": "tsx scripts/bridge-partspec.ts",
    "preflight": "tsx scripts/preflight-deploy.ts",
    "spec:review": "tsx scripts/export-spec.ts",
    "db:migrate:local": "wrangler d1 migrations apply toyventor --local",
    "db:migrate:remote": "wrangler d1 migrations apply toyventor --remote"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@meta-sam/parser": "0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0",
    "@types/three": "^0.183.1"
  }
}
