  "ports": [
    {
      "id": "crown",
      "label": "1x2 Crown Dock",
      "interface": "stud_small",
      "grid": [1, 2],
      "gameSlot": "character.eyes.big",
      "stat": "glow",
      "options": ["buds", "ballcap", "beanie", "cowboy", "hardhat", "ranger", "tophat", "pirate", "hat", "ears", "horns", "blank"],
      "note": "Hats and toppers only. Hair is a separate clip-on wardrobe row (see wardrobe.hatReadyHairs / sculptedTopHairs); a hat only seats on a bald head or a Hat-Ready wig."
    },
    {
      "id": "ears",
      "label": "±X Ear-Pod Ø6.6 Bosses",
      "interface": "stud_small",
      "grid": [1, 1],
      "gameSlot": "character.eyes.big",
      "stat": "glow",
      "options": ["off", "comm", "pro"]
    },
    {
      "id": "back",
      "label": "2x2 Back Dock + Central Ø7.0 Pro Bore",
      "interface": "stud_small",
      "proInterface": "bore_grid",
      "grid": [2, 2],
      "gameSlot": "character.back.jetpack",
      "stat": "speed",
      "options": ["off", "explorer", "jetpack", "wings", "gears"]
    },
    {
      "id": "tail",
      "label": "1x1 Lower-Back Tail Port (2.0 TU below Back Dock)",
      "interface": "bore_grid",
      "grid": [1, 1],
      "offsetFromBackTu": [0, -2],
      "gameSlot": "character.tail.curly",
      "stat": "spin",
      "options": ["off", "wag", "pro"]
    },
    {
      "id": "hand",
      "label": "Right Hand Ø6.6 Pro-Shaft Cradle",
      "interface": "pro_shaft_6p6",
      "grid": [1, 1],
      "gameSlot": "character.base.block",
      "stat": "torque",
      "options": [
        "off", "wrench", "shield", "shaft", "skateboard",
        "hammer", "screwdriver", "paint_roller",
        "mop", "broom", "scrub_brush", "vacuum",
        "guitar", "trumpet", "maracas",
        "flag", "magnifier"
      ],
      "note": "Every prop is a flat-printed head on the same 6.6 mm flat-sided Pro grip shaft as prop_wrench. See wardrobe.propCategories for the demo's category filter."
    }
  ],
  "assets": {
    "stlBaseUrl": "/kip/stls",
    "partspecBaseUrl": "/kip/partspec",
    "customBaseUrl": "/kip/custom",
    "mixamoClips": [
      "/kip/mixamo/Xbot.glb",
