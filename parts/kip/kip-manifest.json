    "faceInserts": [
      { "id": "sculpted", "label": "3D Nose & Orbitals",     "part": "char_faceplate" },
      { "id": "vinyl",    "label": "3D Button Eyes & Nose",  "part": "char_faceplate_vinyl" },
      { "id": "flat",     "label": "Flat Decal Insert",      "part": "char_faceplate_flat" }
    ],
    "faceInsertNote": "One universal face_slot on all 3 human heads, so every insert fits every human head. Robot, animal and creature heads take a conformal 2D decal instead.",
    "shirts": [
      { "id": "spark_tee",  "label": "Spark Bolt Tee" },
      { "id": "hoodie",     "label": "Cobalt Hoodie" },
      { "id": "varsity",    "label": "Varsity Jacket" },
      { "id": "overalls",   "label": "Denim Overalls" },
      { "id": "stripe_tee", "label": "Breton Stripes" },
      { "id": "track_top",  "label": "Racing Track Top" }
    ],
    "pants": [
      { "id": "jeans",          "label": "Cuffed Jeans" },
      { "id": "cargo_shorts",   "label": "Cargo Shorts" },
      { "id": "sport_shorts",   "label": "Sport Shorts" },
      { "id": "joggers",        "label": "Track Joggers" },
      { "id": "overalls_jeans", "label": "Overall Denim" }
    ],
    "outfitNote": "Shirts and pants are solid-filament colour zones with front chest stencil stickers (no longer 2D decals). 'off' is also valid for both."
  },
  "categoryControls": {
    "human":    ["faceInsert", "hair", "hairColor", "hat", "hatColor", "skin", "shirt", "pants", "back", "prop"],
    "robot":    ["visor", "crown", "hatColor", "ears (classic head only)", "tail", "back", "prop"],
    "animal":   ["face", "topper", "hatColor", "shirt", "pants", "tail", "back", "prop"],
    "creature": ["face", "crown", "hatColor", "shirt", "pants", "tail", "back", "prop"],
    "note": "Mirrors syncWardrobeCategoryUi() in Kip-Demo.html: the Wardrobe row shows only the controls that fit the chosen head type. hatColor appears only while a wearable hat is on."
  },
  "pending": [
    {
      "id": "char_head_jumbo",
      "category": "human",
      "status": "in the demo (13 heads) but under review: the three kid/chibi/tall heads share one face zone, wig vault and hat cavity, and char_head_jumbo has its own skull, so it does not seat the face plate, wigs or hats (valid_kip_seated_jumbo fails with a 25 mm3 hat overlap). Keep or retire is undecided; the intended Human set is Soft Youth (neutral), Sweet Heart (feminine) and Heroic Jaw (masculine)."
    }
  ],
  "presets": [
    { "id": "clean",  "label": "Clean",               "head": "classic" },
    { "id": "boy",    "label": "Leo Explorer",        "head": "kid" },
    { "id": "girl",   "label": "Maya Skater",         "head": "chibi" },
    { "id": "kai",    "label": "Kai Moto",            "head": "tall",   "vehicle": "moto" },
    { "id": "scout",  "label": "Mecha Scout",         "head": "scout" },
    { "id": "cat",    "label": "Whisker Cat Scooter", "head": "cat",    "vehicle": "scooter" },
    { "id": "fox",    "label": "Fox Scooter",         "head": "fox",    "vehicle": "scooter" },
    { "id": "dragon", "label": "Drake Dragon",        "head": "dragon" },
    { "id": "imp",    "label": "Yeti Imp",            "head": "imp" },
    { "id": "pro",    "label": "Bolt Pro 8+",         "head": "robot" }
  ],
  "urlParams": {
    "hash": "#toy=<base64url ToyContract> (see shared/toycontract.ts kipDemoUrl())",
    "query": {
      "edition": "snap (default pro)",
      "preset|loadout": "clean | boy | girl | kai | scout | cat | fox | dragon | imp | pro",
      "cat": "human | robot | animal | creature",
      "head": "kid | chibi | tall | jumbo | classic | robot | scout | fox | bear | cat | dragon | alien | imp",
      "insert": "sculpted | vinyl | flat",
      "face|expr": "spark | button | happy | wink | cool | starry | surprised | blank",
      "skin": "warm_peach | golden_tan | rich_cocoa | soft_ivory | vinyl_cream",
      "hair": "off | 14 wig ids (wardrobe.hatReadyHairs + sculptedTopHairs, without the hair_ prefix)",
      "haircol": "wardrobe.hairColors",
      "hat|crown": "ports[crown].options",
      "hatcol": "wardrobe.hatColors",
      "shirt": "off | wardrobe.shirts",
      "pants": "off | wardrobe.pants",
      "back": "off | explorer | jetpack | wings | gears",
      "ears": "off | comm | pro",
      "tail": "off | wag | pro",
      "prop|hand": "ports[hand].options (hand=1|shaft|pro selects the Pro spinner)",
      "vehicle": "none | car | truck | scooter | moto",
      "covers|racer": "0 turns the snap-on body covers / racer kit off",
      "view": "exploded | pile | building (with explode=0..1, bt=build time)",
      "cam": "front | wave | back34 | side34 | vehicle | exploded | pile | head_exploded | head_front | head_close | head_hat | head_side34 | head_profile | head_back34",
      "clip|t": "animation clip key and seek time in seconds",
      "sdk|photo|modal|ref": "wizardHat-style SDK demo, kid-sketch photo forge, open llm/photo modal, reference skeleton"
    }
  },
